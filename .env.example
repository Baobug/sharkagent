# AI Agent 配置示例 —— 复制为 .env.local 后填写（.env.local 已被 gitignore）
#
# 说明：本文件只提供默认值，界面上"设置"面板填写的配置优先级更高。
# 若只想快速体验，无需配置任何一项：默认 mock 模式会本地回放分析结果。

# 接口地址（OpenAI 兼容 base url，不含 /chat/completions）
VITE_AI_BASE_URL=https://api.deepseek.com/v1

# 模型名称
VITE_AI_MODEL=deepseek-chat

# 鉴权信息（切勿提交到仓库）
VITE_AI_API_KEY=

# 关闭演示模式即走真实模型；保持 true 则不发网络请求
VITE_AI_MOCK=true
